rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is logged in as an Admin via Firebase Auth
    function isAdmin() {
      return request.auth != null;
    }

    // Settings Collection (Admin passwords, landing configs, etc)
    match /settings/{document=**} {
      allow read: if true; // Public needs to read landing config and chunks
      allow write: if isAdmin(); // Only admin can update settings
      
      // EXCEPTION: Block public access to admin_creds since we've migrated to Auth
      match /admin_creds {
        allow read, write: if isAdmin(); 
      }
    }

    // Knowledge Base Collections
    match /kb/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /snippets/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /flows/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customers (Only admins can view or edit the raw customer list)
    // Note: the login script queries this. If we block read, public login fails.
    // Solution: We must allow read, but we should migrate to real auth soon.
    match /customers/{document=**} {
      allow read: if true; // Required for manual login for now
      allow write: if isAdmin();
    }

    // Logs & Feedback (Public can write, Admin can read/write)
    match /logs/{document=**} {
      allow read: if isAdmin(); // Only admins can see past logs
      allow create: if true;    // Anyone can save a session log
      allow update, delete: if isAdmin();
    }
    match /feedback/{document=**} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
